{
  "name": "sala-ai",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/hugo:1": {
      "version": "latest",
      "extended": true
    },
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [1313],
  "portsAttributes": {
    "1313": { "label": "Hugo site" }
  },
  "postCreateCommand": "hugo version"
}
